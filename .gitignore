# ---------- 编译产物 ----------
/server
/ai-time-planner
/ai-time-planner.exe
*.exe

# ---------- Go 缓存 ----------
# 本机沙箱环境下 Go 默认缓存目录在工作区之外会被拒绝，
# 因此 scripts/goenv.ps1 会把它们重定向到项目内，不应提交
/.gocache/
/.gopath/

# ---------- 运行时数据 ----------
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/.secret

# ---------- 本地配置 ----------
# 含数据库密码与 API Key，绝不提交
/.env

# ---------- 临时文件 ----------
/tmp/
*.log

# ---------- 本地预览工具（截图 / 演示数据）----------
# 只在开发时用来看渲染效果，不属于产品代码
/.preview/
