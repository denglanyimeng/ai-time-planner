# ---------- 数据库驱动 ----------
# mysql（默认）或 sqlite
# sqlite 为零依赖单文件模式：不需要任何数据库服务，适合「只想马上用起来」
DB_DRIVER=mysql
# 仅 sqlite 模式使用
DB_PATH=data/planner.db

# ---------- MySQL（DB_DRIVER=mysql 时生效）----------
# 与 scripts/init_db.sql 中创建的账号保持一致
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=planner_app
DB_PASSWORD=planner_local_pw_2026
DB_NAME=ai_time_planner

# ---------- 服务 ----------
PORT=8080
# 前端目录（相对项目根目录）
WEB_DIR=web

# ---------- Redis（可选） ----------
# 本系统是单用户本地工具，Redis 只作为可选的加速缓存。
# 保持 false 即可；即使设为 true 而 Redis 未启动，功能也不受影响。
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- AI（OpenAI 兼容接口） ----------
# 留空则计划生成降级为本地规则模式，功能仍然可用。
# 也可以不写在这里，改为在页面「设置」中填写（以页面配置为准）。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
